# kind x0 y0 z0 x1 y1 z1, GoldSrc units. A ramp rises along +x from z0 at x0 to z1 at x1.
box -1024 -1024 -64 1024 1024 0
box -1024 -1024 512 1024 1024 576
box -1088 -1024 0 -1024 1024 512
box 1024 -1024 0 1088 1024 512
box -1024 -1088 0 1024 -1024 512
box -1024 1024 0 1024 1088 512
box -64 -512 0 64 512 256
box 300 200 0 500 260 48
box -600 -700 0 -400 -500 512
box -450 -550 0 -250 -350 300
ramp 400 -800 0 800 -600 200
